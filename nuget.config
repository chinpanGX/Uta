<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="uta-foundation" value="packages" />
  </packageSources>
  <!-- 共通基盤は packages/ から取る（ADR 0019）。作り方は tools/pack-foundation.sh -->
  <packageSourceMapping>
    <packageSource key="uta-foundation">
      <package pattern="VolTech.Server" />
      <package pattern="VolTech.Server.Abstractions" />
      <package pattern="MasterMemory.Addons.Core" />
      <package pattern="MasterMemory.Addons.Tools" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
