<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>Uta.Shared.Domain.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Uta.Shared.Domain\Uta.Shared.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- xunit.v3 4.x は Microsoft.Testing.Platform で動く（ルートの global.json で dotnet test の実行方式を指定） -->
    <PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

</Project>
