{
  "permissions": {
    "allow": [
      "mcp__ccd_turn__update_plan",
      "mcp__ccd_turn__wrap_up",
      "Bash(dotnet build *)",
      "Bash(dotnet test *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/cloud-setup.sh\"",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
