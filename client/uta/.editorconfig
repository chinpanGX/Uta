# Unity クライアント用。ルートの .editorconfig に加えて適用される。
# Unity にソースで入るコードのため、C# 9 の範囲に収める。

[*.{meta,unity,prefab,asset,mat,anim,controller,playable}]
# Unity が生成・書き換えるファイル。エディタ側で整形しない
indent_size = 2
trim_trailing_whitespace = false
insert_final_newline = false

[*.cs]
# ファイルスコープ namespace(C# 10)は使わず、ブロック形式にする
csharp_style_namespace_declarations = block_scoped:suggestion
# プライマリコンストラクタ(C# 12)、コレクション式(C# 12)、Index/Range は使わない
csharp_style_prefer_primary_constructors = false:suggestion
dotnet_style_prefer_collection_expression = never:suggestion
csharp_style_prefer_index_operator = false:suggestion
csharp_style_prefer_range_operator = false:suggestion
csharp_style_prefer_top_level_statements = false:suggestion
