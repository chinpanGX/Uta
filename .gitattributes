# 既定: Git がテキストと判定したファイルは、リポジトリ内も作業ツリーも LF にする
* text=auto eol=lf

# ソース・プロジェクト・設定・ドキュメント(LF 固定)
*.cs        text eol=lf
*.csproj    text eol=lf
*.props     text eol=lf
*.targets   text eol=lf
*.sln       text eol=lf
*.slnx      text eol=lf
*.json      text eol=lf
*.xml       text eol=lf
*.config    text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.md        text eol=lf
*.txt       text eol=lf
*.csv       text eol=lf
*.sh        text eol=lf
*.ps1       text eol=lf
*.proto     text eol=lf
*.sql       text eol=lf
Makefile    text eol=lf
.gitattributes text eol=lf
.gitignore     text eol=lf
.editorconfig  text eol=lf

# Unity のテキストアセット(LF 固定。.meta は必ずコミットする)
*.meta        text eol=lf
*.unity       text eol=lf
*.prefab      text eol=lf
*.asset       text eol=lf
*.mat         text eol=lf
*.anim        text eol=lf
*.controller  text eol=lf
*.playable    text eol=lf
*.asmdef      text eol=lf
*.asmref      text eol=lf
*.shader      text eol=lf
*.hlsl        text eol=lf
*.cginc       text eol=lf
*.uxml        text eol=lf
*.uss         text eol=lf
*.inputactions text eol=lf

# Windows のシェルが CRLF を必要とするもの
*.bat       text eol=crlf
*.cmd       text eol=crlf

# バイナリ(改行変換しない)
