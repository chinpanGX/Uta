*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.psd       binary
*.tga       binary
*.exr       binary
*.hdr       binary
*.fbx       binary
*.wav       binary
*.mp3       binary
*.ogg       binary
*.mp4       binary
*.ttf       binary
*.otf       binary
